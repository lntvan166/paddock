# Copy to .env. Never commit .env.
# Label for this machine, shown in the dashboard header.
PADDOCK_HOST_ID=local
# Override only if herdr's socket is not at $HOME/.config/herdr/herdr.sock
# PADDOCK_HERDR_SOCKET=/herdr.sock
PADDOCK_PORT=8787

# Seeds ~/.config/paddock/settings.json on FIRST RUN ONLY. Once that file
# exists the dashboard owns these values and this is ignored.
# PADDOCK_TELEGRAM_TOKEN=
# PADDOCK_TELEGRAM_CHAT_ID=
# Override where settings.json and update-check.json live
# (default ~/.config/paddock)
# PADDOCK_CONFIG_DIR=

# Set to 1 to stop paddock checking GitHub for a newer release.
#
# The check is already quiet: at most once per 24h, never on a dev build,
# never blocking startup, cached in ~/.config/paddock/update-check.json
# (mode 0600, beside settings.json), and silent in the UI when it fails. But
# it is the only thing a loopback-bound dashboard sends to the internet, so
# the off switch belongs here where you can see it. With this set, no request
# is made and nothing is written.
# PADDOCK_NO_UPDATE_CHECK=1
