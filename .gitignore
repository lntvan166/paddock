# Local private pattern list for scripts/check-private.sh.
# MUST stay untracked: a committed denylist leaks the very strings it protects.
.private-denylist

# Secrets — only .env.example is committed
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies / build output
node_modules/
dist/
dist-demo/
build/
*.tsbuildinfo
paddock
paddock-*

# Release staging: the compiled binaries, their SHA256SUMS, and the rendered
# Homebrew formula (`make formula`). Built by the release workflow in CI and
# reproducible locally; nothing here is source.
out/

# Generated by scripts/gen-embedded.ts (`make embed`). Vite content-hashes
# asset names, so a committed copy would silently drift from the bundle it
# claims to describe.
src/server/embedded.ts

# Runtime / logs
*.log
.DS_Store

# Editor
.vscode/
.idea/

# Agent scratch space. These directories hold brainstorm notes, mockups and
# session state written while working ON this repo, and that material routinely
# contains real agent names, real paths and employer context. It is the most
# likely accidental leak into a public repo, because nobody reviews a scratch
# file the way they review source.
.superpowers/
.claude/
*.local.md

# Isolated workspaces for subagent-driven execution.
.worktrees/
.superpowers/

# Playwright MCP scratch output. Ignored for a privacy reason, not tidiness:
# it lands in the repo root, and a screenshot taken while driving a LIVE
# paddock contains real agent names and a real hostname. Un-ignored, one
# `git add -A` puts that in a public repo. Screenshots for docs are taken from
# `--demo` and copied into docs/images deliberately.
.playwright-mcp/
